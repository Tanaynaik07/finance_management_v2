<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Log in — Finance Manager</title>
  <link rel="stylesheet" href="/styles/style.css" />
</head>
<body>
  <div class="container">
    <div class="card">
      <h1>Log in</h1>

      <% success.forEach(msg => { %><div class="flash flash-success"><%= msg %></div><% }) %>
      <% error.forEach(msg => { %><div class="flash flash-error"><%= msg %></div><% }) %>

      <a class="btn btn-google" href="/auth/google">Continue with Google</a>
      <div class="divider">or</div>

      <form method="POST" action="/login">
        <label>Email</label>
        <input type="email" name="email" required />
        <label>Password</label>
        <input type="password" name="password" required />
        <button type="submit" class="btn btn-primary">Log in</button>
      </form>

      <p class="muted"><a href="/forgot-password">Forgot password?</a></p>
      <p class="muted">No account? <a href="/signup">Sign up</a></p>
    </div>
  </div>
</body>
</html>
