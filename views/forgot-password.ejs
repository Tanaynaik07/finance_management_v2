<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot password — Finance Manager</title>
  <link rel="stylesheet" href="/styles/style.css" />
</head>
<body>
  <div class="container">
    <div class="brand">
      <div class="brand-mark">F</div>
      <span class="brand-name">Finance Manager</span>
    </div>
    <div class="card">
      <h1>Forgot password</h1>

      <% success.forEach(msg => { %><div class="flash flash-success"><%= msg %></div><% }) %>
      <% error.forEach(msg => { %><div class="flash flash-error"><%= msg %></div><% }) %>

      <form method="POST" action="/forgot-password">
        <label>Email</label>
        <input type="email" name="email" required />
        <button type="submit" class="btn btn-primary">Send reset link</button>
      </form>

      <p class="muted"><a href="/login">Back to log in</a></p>
    </div>
  </div>
</body>
</html>
