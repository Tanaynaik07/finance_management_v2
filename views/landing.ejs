<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Finance Manager — Know exactly where your money goes</title>
  <meta name="description" content="A fast, no-friction way to track income and expenses. Sign in with Google and see your balance update instantly." />
  <link rel="stylesheet" href="/styles/style.css" />
</head>
<body>

  <nav class="nav">
    <div class="nav-brand">
      <div class="brand-mark">F</div>
      <span class="brand-name">Finance Manager</span>
    </div>
    <div class="nav-links">
      <a href="/login" class="btn-outline btn-nav">Log in</a>
      <a href="/signup" class="btn btn-primary btn-nav">Sign up free</a>
    </div>
  </nav>

  <header class="hero">
    <div class="hero-copy reveal">
      <span class="eyebrow">Personal finance, simplified</span>
      <h1>Know exactly where<br>your money goes.</h1>
      <p class="hero-sub">Log income and expenses in seconds, watch your balance update instantly, and sign in securely with your Google account. No spreadsheets, no clutter.</p>
      <div class="hero-cta">
        <a href="/signup" class="btn btn-primary btn-lg">Get started — it's free</a>
        <a href="/login" class="btn-link btn-lg">I already have an account →</a>
      </div>
      <ul class="trust-row">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>Google sign-in, no password required</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>Real-time balance, zero setup</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>Free, always</li>
      </ul>
    </div>

    <div class="hero-visual reveal">
      <div class="mock-blob"></div>
      <div class="mock-browser">
        <div class="mock-browser-bar">
          <span class="mock-dot" style="background:#ee6a5f"></span>
          <span class="mock-dot" style="background:#f5bd4f"></span>
          <span class="mock-dot" style="background:#61c454"></span>
          <span class="mock-url">app.financemanager.com/dashboard</span>
        </div>
        <div class="mock-body">
          <div class="summary mock-summary">
            <div class="summary-card income">
              <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg></div>
              <div><span>Income</span><strong>₹48,200</strong></div>
            </div>
            <div class="summary-card expense">
              <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg></div>
              <div><span>Expense</span><strong>₹19,650</strong></div>
            </div>
            <div class="summary-card balance">
              <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="13" rx="2"></rect><path d="M2 10h20"></path><circle cx="17" cy="14.5" r="1.2" fill="currentColor" stroke="none"></circle></svg></div>
              <div><span>Balance</span><strong>₹28,550</strong></div>
            </div>
          </div>
          <table class="mock-table">
            <tbody>
              <tr><td class="income">Income</td><td>Freelance payout</td><td>₹15,000</td></tr>
              <tr><td class="expense">Expense</td><td>Groceries</td><td>₹2,340</td></tr>
              <tr><td class="expense">Expense</td><td>Electricity bill</td><td>₹1,180</td></tr>
              <tr><td class="income">Income</td><td>Stipend</td><td>₹8,000</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </header>

  <section class="how-it-works reveal">
    <h2 class="section-title">How it works</h2>
    <p class="section-sub">Three steps, no manual, no waiting.</p>
    <div class="steps">
      <div class="step">
        <div class="step-num">1</div>
        <h3>Sign in with Google</h3>
        <p>One click. No forms, no password to remember. Your account is isolated and secure from the first second.</p>
      </div>
      <div class="step">
        <div class="step-num">2</div>
        <h3>Log a transaction</h3>
        <p>Add income or an expense with a category and amount. Takes less time than opening a spreadsheet.</p>
      </div>
      <div class="step">
        <div class="step-num">3</div>
        <h3>Watch your balance update</h3>
        <p>Your dashboard recalculates instantly — no refresh, no sync delay, no stale numbers.</p>
      </div>
    </div>
  </section>

  <section class="features reveal">
    <div class="feature-card">
      <div class="icon income-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
      </div>
      <h3>Track every transaction</h3>
      <p>Add income and expenses in one place, categorize them, and see your running balance update in real time.</p>
    </div>
    <div class="feature-card">
      <div class="icon balance-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
      </div>
      <h3>Secure by default</h3>
      <p>Sign in with Google or a verified email address. Sessions are encrypted and every account is fully isolated.</p>
    </div>
    <div class="feature-card">
      <div class="icon expense-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"></rect><line x1="3" y1="10" x2="21" y2="10"></line><line x1="7" y1="15" x2="11" y2="15"></line></svg>
      </div>
      <h3>Always up to date</h3>
      <p>Your dashboard reflects every change instantly — no syncing, no refreshing, no waiting.</p>
    </div>
  </section>

  <section class="cta-band reveal">
    <h2>Start tracking your money in under a minute.</h2>
    <a href="/signup" class="btn btn-primary btn-lg">Get started — it's free</a>
  </section>

  <footer class="site-footer">
    <div class="footer-main">
      <span>© <%= new Date().getFullYear() %> Finance Manager</span>
      <div class="footer-links">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </div>
    </div>
    <div class="tech-strip">Built with Node.js · Express · MongoDB · Passport · Google OAuth</div>
  </footer>

  <script>
    (function () {
      var els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) {
        els.forEach(function (el) { el.classList.add('in-view'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      els.forEach(function (el) { io.observe(el); });
    })();
  </script>

</body>
</html>
